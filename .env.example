# Aadi SpendOS - deployment inputs. Copy to .env (git-ignored) and fill in. Never commit .env.

# ---- Coolify access (required) ------------------------------------------------------------
# Dashboard address, no trailing slash, e.g. https://coolify.aaditechnology.com
COOLIFY_URL=
# Coolify -> Keys & Tokens -> API tokens. Needs permission to read, write and deploy.
COOLIFY_API_TOKEN=

# ---- Where to put it in Coolify (leave blank if you want me to list them and pick) --------
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT_NAME=production

# ---- Git source (repo: https://github.com/aadiTechnology/expenses.git, branch main) ---------
# Only if the repository is PRIVATE: the UUID of the GitHub App or deploy key already added in Coolify.
COOLIFY_GITHUB_APP_UUID=
COOLIFY_PRIVATE_KEY_UUID=

# ---- Email (SMTP) ---------------------------------------------------------------------------
SPENDOS_SMTP_HOST=
SPENDOS_SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SPENDOS_SMTP_SECURITY=starttls
SPENDOS_SMTP_USER=
SPENDOS_SMTP_PASSWORD=
SPENDOS_SMTP_FROM=Aadi SpendOS <no-reply@aaditechnology.com>

# ---- Already decided (change only if the plan changes) -------------------------------------
SPENDOS_UI_URL=https://expenses.aaditechnology.com
SPENDOS_API_URL=https://expensesapi.aaditechnology.com
